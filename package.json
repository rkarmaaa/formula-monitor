{
  "name": "formula-monitor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard live per la telemetria UDP di F1 25 (PS5, Xbox, PC), ottimizzata per display verticali 9:16.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "start": "node server/start.ts",
    "mock": "node server/mock.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "astro check",
    "format": "prettier --write .",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@iconify-json/lucide": "^1.2.147",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "gridstack": "^14.0.0",
    "sass": "^1.106.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
