---
import { href } from '@lib/paths';
import '@styles/main.scss';
import { Font } from 'astro:assets';
import SeoHead from '@components/global/SeoHead.astro';
import SkipLink from '@components/global/SkipLink.astro';
import { t } from '@i18n/index';
import { defaultGameId, games } from '@data/games';

interface Props {
  title: string;
  description: string;
  class?: string;
}

const { class: className, ...seo } = Astro.props;
const gameIds = games.map((game) => game.id);
---

<!doctype html>
<html lang="it" data-game={defaultGameId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#08090c" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline define:vars={{ gameIds }}>
      // Versione di gioco salvata applicata prima del primo paint: niente sfarfallio dei valori
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('fm:game');
        if (gameIds.includes(saved)) document.documentElement.dataset.game = saved;
      } catch {}
    </script>
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-body" preload />
    <SeoHead {...seo} />
  </head>
  <body class={className}>
    <SkipLink label={t.common.skip} />
    <slot />
  </body>
</html>
