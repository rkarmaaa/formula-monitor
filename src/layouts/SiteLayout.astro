---
import BaseLayout from './BaseLayout.astro';
import Footer from '@components/global/Footer.astro';

// Pagine informative (home, 404): niente navbar, solo contenuto e un piè di pagina minimo
interface Props {
  title: string;
  description: string;
}
---

<BaseLayout {...Astro.props} class="site">
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<script>
  import '@scripts/reveal';
  import '@scripts/site';
</script>
