---
import LogoMark from './LogoMark.astro';
import { t } from '@i18n/index';

// Logotipo: simbolo + "FORMULA" pesante e "MONITOR" leggero. variant mark = solo simbolo
interface Props {
  variant?: 'full' | 'mark';
  size?: 'md' | 'lg';
  mono?: boolean;
  href?: string;
  class?: string;
}

const { variant = 'full', size = 'md', mono = false, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
const [first, second] = t.common.brand.split(' ');
---

<Tag
  class:list={['logo', variant, size, { mono }, className]}
  href={href}
  aria-label={href ? t.common.brand : undefined}
>
  <LogoMark title={href ? undefined : t.common.brand} />
  {variant === 'full' && (
    <span class="logo-word" aria-hidden="true">
      <span class="logo-strong">{first}</span>
      <span class="logo-light">{second}</span>
    </span>
  )}
</Tag>
