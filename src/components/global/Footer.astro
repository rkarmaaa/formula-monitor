---
import { href } from '@lib/paths';
import Icon from '@components/ui/Icon.astro';
import { t } from '@i18n/index';
import { site } from '@data/site';

const year = new Date().getFullYear();
const f = t.common.footer;
---

<footer class="site-footer">
  <p class="site-footer-brand">
    © {year} {t.common.brand} · v{site.version}
  </p>
  <p class="site-footer-legal">{f.disclaimer}</p>
  <nav class="site-footer-links" aria-label={t.common.brand}>
    <a class="site-footer-link" href={href('monitor/?demo')} title={f.simulationHint}>
      <Icon name="lucide:terminal" />
      {f.simulation}
    </a>
    <a class="site-footer-link" href={site.repository}>
      {f.source}
    </a>
  </nav>
</footer>
