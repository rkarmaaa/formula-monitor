---
import Logo from '@components/brand/Logo.astro';
import { t } from '@i18n/index';
import { site } from '@data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <Logo />
      <p class="site-footer-tagline">{t.common.tagline}</p>
    </div>
    <div class="site-footer-legal">
      <p>{t.common.footer.spec}</p>
      <p>{t.common.footer.disclaimer}</p>
      <p>
        © {year}
        {t.common.brand} · v{site.version} · <a href={site.repository}>{t.common.footer.source}</a>
      </p>
    </div>
  </div>
</footer>
