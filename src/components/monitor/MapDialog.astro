---
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { t } from '@i18n/index';

// Opzioni del blocco mappa: stile, etichette, livelli mostra/nascondi, rotazione
const m = t.monitor.mapOptions;
const presets = Object.entries(m.presets);
const labels = Object.entries(m.labelModes);
const layers = Object.entries(m.layerNames);
const rotations = ['auto', '0', '90', '180', '270'];
---

<dialog class="panel-dialog" data-map-dialog aria-labelledby="map-dialog-title">
  <form class="panel-dialog-form" method="dialog">
    <header class="panel-dialog-head">
      <h2 class="panel-dialog-title" id="map-dialog-title">
        {m.title}
      </h2>
      <button class="panel-dialog-close" type="button" data-dialog-close aria-label={m.close}>
        <Icon name="lucide:x" />
      </button>
    </header>
    <fieldset class="panel-dialog-group">
      <legend>{m.preset}</legend>
      <div class="panel-dialog-presets">
        {presets.map(([value, label]) => (
          <label class="panel-dialog-preset" data-preset={value}>
            <input type="radio" name="preset" value={value} />
            <span class="panel-dialog-swatch" aria-hidden="true" />
            <span>{label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="panel-dialog-group">
      <legend>{m.labels}</legend>
      <div class="panel-dialog-segmented">
        {labels.map(([value, label]) => (
          <label class="panel-dialog-segment">
            <input type="radio" name="labels" value={value} />
            <span>{label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="panel-dialog-group">
      <legend>{m.rotate}</legend>
      <div class="panel-dialog-segmented">
        {rotations.map((value) => (
          <label class="panel-dialog-segment">
            <input type="radio" name="rotation" value={value} />
            <span>{value === 'auto' ? m.auto : `${value}°`}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="panel-dialog-group">
      <legend>{m.layers}</legend>
      <div class="panel-dialog-toggles">
        {layers.map(([name, label]) => (
          <label class="panel-dialog-toggle">
            <input type="checkbox" name={name} role="switch" />
            <span>{label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <footer class="panel-dialog-foot">
      <Button size="sm" icon="lucide:check" data-dialog-close>
        {m.close}
      </Button>
    </footer>
  </form>
</dialog>
