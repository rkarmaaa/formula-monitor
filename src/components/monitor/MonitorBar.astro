---
import { href } from '@lib/paths';
import Icon from '@components/ui/Icon.astro';
import { t } from '@i18n/index';

// Barra in basso: indirizzo del sito, stato della sorgente, sessione, schermo intero ed uscita.
// In simulazione (?demo) a destra compare anche il selettore della schermata: la vista attuale con le doppie
// frecce, al clic un menu con le viste disponibili. Nell'app (exe, npm start) la home non c'è: niente uscita.
const bar = t.monitor.bar;
const hasHome = import.meta.env.PUBLIC_TARGET === 'site' || import.meta.env.DEV;
const modes = [
  { id: 'qualifying', label: bar.modes.qualifying },
  { id: 'race', label: bar.modes.race },
];
---

<nav class="monitor-bar" aria-label={bar.label}>
  <a class="monitor-bar-domain" href={hasHome ? href('') : href('monitor/')} data-domain>
    {t.common.brand}
  </a>
  <p class="monitor-bar-status" data-status data-state="connecting" role="status">
    <span class="monitor-bar-dot" aria-hidden="true"></span>
    <span data-status-label>{t.monitor.status.connecting}</span>
  </p>
  <p class="monitor-bar-session" data-bind>
    <span data-text="session.trackId|track"></span>
    <span data-text="session.sessionType|session"></span>
  </p>
  <div class="monitor-bar-modes" data-modes hidden>
    <button
      class="monitor-bar-mode"
      type="button"
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="monitor-modes"
      aria-label={bar.modes.label}
      data-mode-toggle
    >
      <span data-mode-label>{modes[0]!.label}</span>
      <Icon name="lucide:chevrons-up-down" />
    </button>
    <ul class="monitor-bar-menu" id="monitor-modes" aria-label={bar.modes.label} hidden>
      {modes.map(({ id, label }) => (
        <li>
          <button class="monitor-bar-option" type="button" aria-pressed="false" data-mode={id}>
            {label}
            <Icon name="lucide:check" />
          </button>
        </li>
      ))}
    </ul>
  </div>
  <div class="monitor-bar-actions">
    <button class="monitor-bar-button" type="button" data-action="fullscreen" aria-label={bar.fullscreen}>
      <Icon name="lucide:maximize" />
    </button>
    {hasHome && (
      <a class="monitor-bar-button" href={href('')} aria-label={bar.exit}>
        <Icon name="lucide:x" />
      </a>
    )}
  </div>
</nav>
