---
import { href } from '@lib/paths';
import Icon from '@components/ui/Icon.astro';
import { t } from '@i18n/index';

// Barra in basso: indirizzo del sito, stato della sorgente, sessione, schermo intero ed uscita
const bar = t.monitor.bar;
---

<nav class="monitor-bar" aria-label={bar.label}>
  <a class="monitor-bar-domain" href={href('')} data-domain>
    {t.common.brand}
  </a>
  <p class="monitor-bar-status" data-status data-state="connecting" role="status">
    <span class="monitor-bar-dot" aria-hidden="true"></span>
    <span data-status-label>{t.monitor.status.connecting}</span>
  </p>
  <p class="monitor-bar-session" data-bind>
    <span data-text="session.trackId|track"></span>
    <span data-text="session.sessionType|session"></span>
  </p>
  <div class="monitor-bar-actions">
    <button class="monitor-bar-button" type="button" data-action="fullscreen" aria-label={bar.fullscreen}>
      <Icon name="lucide:maximize" />
    </button>
    <a class="monitor-bar-button" href={href('')} aria-label={bar.exit}>
      <Icon name="lucide:x" />
    </a>
  </div>
</nav>
