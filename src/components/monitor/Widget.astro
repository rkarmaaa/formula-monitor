---
import Block from '@components/blocks/Block.astro';
import { widgetById, type WidgetId } from '@data/widgets';
import { t } from '@i18n/index';

// Blocchi della simulazione completa: stessa cornice dei blocchi base, misura dal catalogo (griglia 12 × 24)
interface Props {
  id: WidgetId;
}

const { id } = Astro.props;
const def = widgetById(id)!;
const game = 'games' in def ? def.games[0] : undefined;
---

<Block id={id} title={t.widgets[id].title} span={def.size} game={game}>
  <slot name="meta" slot="meta" />
  <slot />
</Block>
