---
import { defaultGameId, games } from '@data/games';
import { t } from '@i18n/index';

// Selettore della versione di gioco: radio native, la scelta vale per guida e monitor
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<fieldset class:list={['game-picker', { compact }]} data-game-picker>
  <legend class="game-picker-legend">{t.games.legend}</legend>
  <div class="game-picker-options">
    {games.map((game) => (
      <label class="game-option">
        <input class="game-option-input" type="radio" name="game" value={game.id} checked={game.id === defaultGameId} />
        <span class="game-option-badge">{t.games[game.id].badge}</span>
        <span class="game-option-name">{t.games[game.id].name}</span>
        <span class="game-option-detail">{t.games[game.id].detail}</span>
      </label>
    ))}
  </div>
</fieldset>
