---
import Icon from '@components/ui/Icon.astro';
import { t } from '@i18n/index';

// Comandi da terminale (o URL) con bottone copia; `live` = valore riempito dal bridge
interface Props {
  lines: string[];
  live?: 'url';
}

const { lines, live } = Astro.props;
---

<ol class="command-list">
  {lines.map((line) => (
    <li class="command-list-line">
      <code class="command-list-code" data-bridge-url={live ? '' : undefined}>
        {line}
      </code>
      <button class="command-list-copy" type="button" data-copy aria-label={t.common.copy}>
        <Icon name="lucide:copy" />
      </button>
    </li>
  ))}
</ol>
