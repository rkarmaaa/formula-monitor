---
import { ports } from '@data/games';
import { t } from '@i18n/index';

// Tabella completa dei valori da inserire nel gioco: IP dal bridge live, nessuna riga nascosta
const s = t.home.settings;
const rows = [
  s.telemetry,
  s.broadcast,
  { option: s.ip.option, why: s.ip.why, value: undefined },
  { ...s.port, value: String(ports.udp) },
  s.rate,
  s.format,
  s.telemetryPublic,
  s.names,
];
---

<div class="udp-settings">
  <table class="udp-settings-table">
    <caption class="udp-settings-caption">{t.home.settingsCaption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.home.columns.option}</th>
        <th scope="col">{t.home.columns.value}</th>
        <th scope="col" class="udp-settings-why">
          {t.home.columns.why}
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.option}</th>
          <td class="udp-settings-value">
            {row.value ?? (
              <span data-bridge-ip data-empty>
                {t.home.ipPlaceholder}
              </span>
            )}
          </td>
          <td class="udp-settings-why">{row.why}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
