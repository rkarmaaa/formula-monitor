---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.events;
---

<Widget id="events">
  <div class="w-events">
    <p class="w-events-empty">{w.empty}</p>
    <ol class="w-events-list" data-list="events" data-key="id" data-limit="24">
      <template>
        <li class="w-events-item" data-attr="data-tone:event.code|eventTone; data-player:car.isPlayer|bool">
          <span class="w-events-lap" data-text="lap|lapLabel"></span>
          <span class="w-events-text" data-text=".|event"></span>
        </li>
      </template>
    </ol>
  </div>
</Widget>
