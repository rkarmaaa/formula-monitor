---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.gforce;
---

<Widget id="gforce">
  <div class="w-gforce">
    <div
      class="w-gforce-dial"
      data-var="--x:player.motion.gForceLateral|signedRatio:5; --y:player.motion.gForceLongitudinal|signedRatio:5"
      aria-hidden="true"
    >
      <span class="w-gforce-dot"></span>
    </div>
    <dl class="w-gforce-values">
      <div>
        <dt>{w.lat}</dt>
        <dd>
          <span data-text="player.motion.gForceLateral|fixed:1"></span> · <span data-peak-lat>—</span>
        </dd>
      </div>
      <div>
        <dt>{w.lon}</dt>
        <dd>
          <span data-text="player.motion.gForceLongitudinal|fixed:1"></span> · <span data-peak-lon>—</span>
        </dd>
      </div>
    </dl>
  </div>
</Widget>
