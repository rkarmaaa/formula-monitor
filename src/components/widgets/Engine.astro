---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.engine;
const parts = [
  { key: 'engineICEWear', label: 'ICE' },
  { key: 'engineMGUHWear', label: 'MGU-H' },
  { key: 'engineMGUKWear', label: 'MGU-K' },
  { key: 'engineESWear', label: 'ES' },
  { key: 'engineCEWear', label: 'CE' },
  { key: 'engineTCWear', label: 'TC' },
  { key: 'gearBoxDamage', label: w.gearbox },
];
---

<Widget id="engine">
  <div class="w-engine">
    <ul class="w-engine-parts">
      {parts.map((part) => (
        <li class="w-engine-part" data-attr={`data-tone:player.damage.${part.key}|tone:pu`}>
          <span class="w-engine-name">{part.label}</span>
          <span class="w-engine-meter" data-var={`--v:player.damage.${part.key}|ratio:100`} />
          <span class="w-engine-value" data-text={`player.damage.${part.key}|pct`} />
        </li>
      ))}
    </ul>
    <p class="w-engine-meta">
      <span data-attr="data-tone:player.telemetry.engineTemperature|tone:engine">
        {w.temp} <b data-text="player.telemetry.engineTemperature|temp"></b>
      </span>
      <span>
        {w.power} <b data-text="player.status.enginePowerICE|kw"></b>+
        <b data-text="player.status.enginePowerMGUK|kw"></b> kW
      </span>
    </p>
  </div>
</Widget>
