---
import Widget from '@components/monitor/Widget.astro';
import { fill } from '@lib/text';
import { t } from '@i18n/index';

const w = t.widgets.flags;
---

<Widget id="flags">
  <div
    class="w-flags"
    data-attr="data-sc:flags.safetyCar|scClass; data-red:flags.redFlag|bool; data-blue:flags.player|eq:2"
  >
    <p class="w-flags-state">
      <span class="w-flags-red">{w.red}</span>
      <span class="w-flags-sc" data-text="flags.safetyCar|safetyCar">
        {w.green}
      </span>
    </p>
    <ol class="w-flags-sectors">
      {[0, 1, 2].map((i) => (
        <li class="w-flags-sector" data-attr={`data-yellow:flags.yellowSectors.${i}|bool`}>
          {fill(w.sector, { n: i + 1 })}
        </li>
      ))}
    </ol>
    <p class="w-flags-blue">{w.blue}</p>
    <ol class="w-flags-lights" data-attr="hidden:race.lightsOn|not" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((i) => (
        <li class="w-flags-light" data-attr={`data-on:race.lightsSlots.${i}|bool`} />
      ))}
    </ol>
  </div>
</Widget>
