---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.speedtrap;
---

<Widget id="speedtrap">
  <div class="w-trap">
    <ol class="w-trap-list" data-list="speedTraps" data-limit="5">
      <template>
        <li class="w-trap-row" data-attr="data-player:car.isPlayer|bool" data-var="--team:car.teamId|team">
          <span class="w-trap-code" data-text="car.code"></span>
          <span class="w-trap-speed" data-text="speed|speed"></span>
        </li>
      </template>
    </ol>
    <p class="w-trap-you">
      {w.you} <b data-text="player.lap.speedTrapFastestSpeed|speed"></b>
      <span data-text="units.speed|speedUnit"></span>
    </p>
  </div>
</Widget>
