---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.lap;
---

<Widget id="lap">
  <div class="w-lap">
    <p class="w-lap-main">
      <span class="w-lap-value" data-text="race.lap">
        —
      </span>
      <span class="w-lap-total">
        /<span data-text="race.totalLaps"></span>
      </span>
    </p>
    <div class="w-lap-progress" data-var="--v:race.progress|unit"></div>
    <p class="w-lap-meta">
      <span>
        <b data-text="race.lapsLeft"></b> {w.left}
      </span>
      <span data-text="race.timeLeft|time"></span>
    </p>
  </div>
</Widget>
