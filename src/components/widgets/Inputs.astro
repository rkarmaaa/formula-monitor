---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.inputs;
---

<Widget id="inputs">
  <div class="w-inputs">
    <div class="w-inputs-pedals">
      <span class="w-inputs-pedal throttle" data-var="--v:player.telemetry.throttle|unit" title={w.throttle}></span>
      <span class="w-inputs-pedal brake" data-var="--v:player.telemetry.brake|unit" title={w.brake}></span>
    </div>
    <div class="w-inputs-chart">
      <canvas class="w-inputs-canvas" data-trace></canvas>
      <span class="w-inputs-steer" data-var="--s:player.telemetry.steer|signedRatio:1" title={w.steer}></span>
    </div>
  </div>
</Widget>
