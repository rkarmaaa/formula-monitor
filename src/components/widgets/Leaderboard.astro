---
import Widget from '@components/monitor/Widget.astro';
import TyreChip from '@components/monitor/TyreChip.astro';
import Icon from '@components/ui/Icon.astro';
import { t } from '@i18n/index';

const w = t.widgets.leaderboard;
---

<Widget id="leaderboard">
  <div class="w-board">
    <p class="w-board-head" aria-hidden="true">
      <span>{w.pos}</span>
      <span>{w.driver}</span>
      <span class="w-board-gap">{w.gap}</span>
      <span class="w-board-tyre">{w.tyre}</span>
      <span class="w-board-stops">{w.stops}</span>
      <span class="w-board-last">{w.last}</span>
    </p>
    <ol class="w-board-list" data-list="cars" data-key="index" data-flip>
      <template>
        <li
          class="w-board-row"
          data-attr="data-player:isPlayer|bool; data-out:retired|bool; data-pit:inPit|bool"
          data-var="--team:teamId|team"
        >
          <span class="w-board-pos" data-text="position"></span>
          <span class="w-board-driver">
            <span class="w-board-code" data-text="code"></span>
            <span class="w-board-flags">
              <span class="w-board-tag pit">{w.pit}</span>
              <span class="w-board-tag out">{w.out}</span>
              <span class="w-board-pen" data-attr="hidden:lap.penalties|not">
                <span data-text="lap.penalties"></span>s
              </span>
              <span class="w-board-warn" data-attr="hidden:lap.cornerCuttingWarnings|not">
                <Icon name="lucide:triangle-alert" />
                <span data-text="lap.cornerCuttingWarnings"></span>
              </span>
              <span class="w-board-fastest" data-attr="hidden:fastestLap|not">
                <Icon name="lucide:timer" />
              </span>
            </span>
          </span>
          <span class="w-board-gap" data-text=".|interval"></span>
          <span class="w-board-tyre">
            <TyreChip path="status.visualTyreCompound" />
            <span data-text="status.tyresAgeLaps"></span>
          </span>
          <span class="w-board-stops" data-text="lap.numPitStops"></span>
          <span class="w-board-last" data-text="lastLapMs|lapTime" data-attr="data-best:fastestLap|bool"></span>
        </li>
      </template>
    </ol>
  </div>
</Widget>
