---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

// 15 LED di cambiata: si accendono via CSS confrontando --rev con l'indice del LED
const w = t.widgets.cockpit;
const leds = Array.from({ length: 15 }, (_, i) => i);
---

<Widget id="cockpit">
  <div class="w-cockpit">
    <ol class="w-cockpit-leds" data-var="--rev:player.telemetry.revLightsPercent|ratio:100" aria-hidden="true">
      {leds.map((i) => (
        <li class="w-cockpit-led" style={`--i: ${i}`} />
      ))}
    </ol>
    <div class="w-cockpit-core">
      <p class="w-cockpit-gear" data-text="player.telemetry.gear|gear" aria-label={w.gear}>
        N
      </p>
      <p class="w-cockpit-speed">
        <span class="w-cockpit-kmh" data-text="player.telemetry.speed|speed">
          0
        </span>
        <span class="w-cockpit-unit" data-text="units.speed|speedUnit"></span>
      </p>
    </div>
    <div class="w-cockpit-rpm" data-var="--v:player.rpmRatio|unit"></div>
    <p class="w-cockpit-chips">
      <span
        class="w-cockpit-chip"
        data-game-only="f1-25"
        data-attr="data-on:player.telemetry.drs|bool; data-ready:player.status.drsAllowed|bool"
      >
        {w.drs}
      </span>
      <span
        class="w-cockpit-chip"
        data-game-only="f1-25-2026"
        data-attr="data-on:player.telemetry2.overtakeActive|bool; data-ready:player.telemetry2.overtakeAvailable|bool"
      >
        {t.widgets.aero.overtake}
      </span>
      <span class="w-cockpit-chip">
        {w.ers} <b data-text="player.ersPct|pct"></b>
      </span>
      <span class="w-cockpit-chip">
        {w.rpm} <b data-text="player.telemetry.engineRPM|thousands"></b>
      </span>
    </p>
  </div>
</Widget>
