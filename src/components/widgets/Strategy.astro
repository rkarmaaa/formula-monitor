---
import Widget from '@components/monitor/Widget.astro';
import TyreChip from '@components/monitor/TyreChip.astro';
import { t } from '@i18n/index';

const w = t.widgets.strategy;
---

<Widget id="strategy">
  <div class="w-strategy">
    <div class="w-strategy-window">
      <p class="w-strategy-label">{w.window}</p>
      <div class="w-strategy-track" data-var="--from:pit.from|unit; --to:pit.to|unit; --now:race.progress|unit">
        <span class="w-strategy-range"></span>
        <span class="w-strategy-now"></span>
      </div>
      <p class="w-strategy-laps">
        <span>
          {w.ideal} <b data-text="pit.idealLap|lapLabel"></b>
        </span>
        <span>
          {w.latest} <b data-text="pit.latestLap|lapLabel"></b>
        </span>
      </p>
    </div>
    <dl class="w-strategy-facts">
      <div class="w-strategy-fact">
        <dt>{w.rejoin}</dt>
        <dd data-text="pit.rejoinPosition|pos"></dd>
      </div>
      <div class="w-strategy-fact">
        <dt>{t.widgets.fuel.delta}</dt>
        <dd data-text="race.fuelDeltaLaps|signedLaps" data-attr="data-tone:race.fuelDeltaLaps|fuelTone"></dd>
      </div>
      <div class="w-strategy-fact">
        <dt>{w.age}</dt>
        <dd>
          <span data-text="player.status.tyresAgeLaps"></span> · <span data-text="player.wearMax|pct"></span>
        </dd>
      </div>
    </dl>
    <div class="w-strategy-stints">
      <p class="w-strategy-label">{w.stints}</p>
      <ol class="w-strategy-list" data-list="player.stints">
        <template>
          <li class="w-strategy-stint">
            <TyreChip path="." />
          </li>
        </template>
      </ol>
    </div>
  </div>
</Widget>
