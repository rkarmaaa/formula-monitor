---
import Widget from '@components/monitor/Widget.astro';
import { t } from '@i18n/index';

const w = t.widgets.drs;
---

<Widget id="drs">
  <div class="w-drs" data-attr="data-open:player.telemetry.drs|bool; data-ready:player.status.drsAllowed|bool">
    <p class="w-drs-badge">DRS</p>
    <p class="w-drs-state">
      <span class="w-drs-open">{w.open}</span>
      <span class="w-drs-ready">{w.available}</span>
      <span class="w-drs-off">{w.off}</span>
    </p>
    <p
      class="w-drs-distance"
      data-text="player.status.drsActivationDistance|distanceIn"
      data-attr="hidden:player.status.drsActivationDistance|not"
    ></p>
  </div>
</Widget>
