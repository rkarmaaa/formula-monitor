---
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  name: string;
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
---

<AstroIcon
  name={name}
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
/>
