---
import { accent } from '@lib/text';

// Eyebrow + titolo (con *accento*) + lead
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  id?: string;
  level?: 1 | 2;
  size?: 'display' | 'h1' | 'h2';
  align?: 'start' | 'center';
  class?: string;
}

const { title, eyebrow, lead, id, level = 2, size = 'h2', align = 'start', class: className } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<header class:list={['section-title', size, align, className]}>
  {eyebrow && (
    <p class="section-title-eyebrow" data-reveal="fade">
      {eyebrow}
    </p>
  )}
  <Heading class="section-title-heading" id={id} data-reveal set:html={accent(title)} />
  {lead && (
    <p class="section-title-lead" data-reveal>
      {lead}
    </p>
  )}
  <slot />
</header>
