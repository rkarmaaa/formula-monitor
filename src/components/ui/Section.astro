---
interface Props {
  id?: string;
  tone?: 'base' | 'alt';
  size?: 'md' | 'sm';
  width?: 'default' | 'narrow' | 'wide';
  labelledby?: string;
  class?: string;
}

const { id, tone = 'base', size = 'md', width = 'default', labelledby, class: className } = Astro.props;
---

<section id={id} class:list={['section', tone, size, width, className]} aria-labelledby={labelledby}>
  <div class="section-inner">
    <slot />
  </div>
</section>
