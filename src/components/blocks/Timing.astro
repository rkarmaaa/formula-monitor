---
import TeamLogo from './TeamLogo.astro';
import { t } from '@i18n/index';

// Classifica live per i giri veloci: posizione, logo, sigla e mescola; giro migliore (viola il più veloce)
// e settori (viola = migliore assoluto, verde = personale, attenuati quelli del giro precedente).
// A sinistra del giro migliore il distacco dal primo: sul giro migliore in qualifica, sul traguardo in gara.
const b = t.monitor.blocks.timing;
const sectors = [0, 1, 2];
---

<section class="timing-tower" data-block="timing" data-attr="data-race:race.isRace|bool" aria-labelledby="timing-title">
  <p class="timing-tower-head">
    <span class="timing-tower-title" id="timing-title">
      {b.title}
    </span>
    <span class="timing-tower-interval"></span>
    <span class="timing-tower-best">{b.best}</span>
    {sectors.map((i) => (
      <span class="timing-tower-sector">{b.sectors[i]}</span>
    ))}
  </p>
  <ol class="timing-tower-list" data-list="cars" data-key="index" data-flip>
    <template>
      <li
        class="timing-tower-row"
        data-attr="data-player:isPlayer|bool; data-pit:inPit|bool; data-garage:inGarage|bool; data-out:retired|bool"
      >
        <span class="timing-tower-driver">
          <span class="timing-tower-pos" data-text="position|pad2"></span>
          <TeamLogo path="teamId" />
          <span class="timing-tower-code" data-text="code"></span>
          <span
            class="timing-tower-tyre"
            data-text="status.visualTyreCompound|compoundLetter"
            data-attr="data-compound:status.visualTyreCompound|compoundClass"
          ></span>
          <span class="timing-tower-tag pit">{b.pit}</span>
          <span class="timing-tower-tag out">{b.out}</span>
        </span>
        <span class="timing-tower-interval" data-text=".|towerGap" data-attr="data-leader:position|eq:1"></span>
        <span class="timing-tower-best" data-text="bestLapMs|lapTime" data-attr="data-tone:bestLapTone"></span>
        {sectors.map((i) => (
          <span
            class="timing-tower-sector"
            data-text={`sectors.${i}.ms|sectorTime`}
            data-attr={`data-tone:sectors.${i}.tone; data-live:sectors.${i}.live|bool`}
          ></span>
        ))}
      </li>
    </template>
  </ol>
</section>
