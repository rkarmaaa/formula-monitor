---
import { t } from '@i18n/index';

// Scheda del giocatore: posizione e mescola montata; settori del giro in corso (viola/verde/rosso, colorati ancora
// qualche secondo dopo il traguardo, poi grigi), delta live sul proprio miglior giro (al massimo 3 aggiornamenti
// al secondo, data-every; fermo a fine sessione), ultimo e migliore
const b = t.monitor.blocks.player;
const sectors = [0, 1, 2];
---

<section class="player-card" data-block="player" aria-label={b.title}>
  <div class="player-card-place">
    <p class="player-card-position" aria-label={b.position}>
      P<span data-text="player.position"></span>
    </p>
    <p class="player-card-compound" data-attr="data-compound:player.status.visualTyreCompound|compoundClass">
      <span class="player-card-chip" data-text="player.status.visualTyreCompound|compoundLetter"></span>
      <span data-text="player.status.visualTyreCompound|compoundName"></span>
    </p>
  </div>
  <div class="player-card-times">
    <ol class="player-card-sectors">
      {sectors.map((i) => (
        <li
          class="player-card-sector"
          data-attr={`data-tone:playerSectors.${i}.tone; data-live:playerSectors.${i}.live|bool`}
        >
          <span>{b.sectors[i]}</span>
        </li>
      ))}
    </ol>
    <p class="player-card-delta">
      <span class="player-card-label">{b.delta}</span>
      <span
        class="player-card-delta-value"
        data-text="liveDeltaMs|delta"
        data-attr="data-tone:liveDeltaMs|deltaTone"
        data-every="334"
      ></span>
    </p>
    <dl class="player-card-laps">
      <div class="player-card-lap">
        <dt>{b.last}</dt>
        <dd data-text="player.lastLapMs|lapTime"></dd>
      </div>
      <div class="player-card-lap">
        <dt>{b.best}</dt>
        <dd data-text="player.bestLapMs|lapTime"></dd>
      </div>
    </dl>
  </div>
</section>
