---
import CarShape from './CarShape.astro';
import { t } from '@i18n/index';

// Gomme e ali (Figma nodo 1284:947): sagoma della vettura al centro con le gomme colorate dall'usura, un anello
// aperto accanto a ogni gomma e il danno di ala anteriore (sopra) e alettone (sotto), anch'essi ad anello.
// Gli anelli sono aperti verso la vettura; il colore passa gradualmente da verde a giallo, arancio e rosso
// (mixin wear-color). Indici delle gomme come nelle specifiche UDP: 0 post. sx, 1 post. dx, 2 ant. sx, 3 ant. dx.
const b = t.monitor.blocks.car;
const wheels = [
  { i: 2, place: 'front left' },
  { i: 3, place: 'front right' },
  { i: 0, place: 'rear left' },
  { i: 1, place: 'rear right' },
];
const wings = [
  { place: 'front', label: b.frontWing },
  { place: 'rear', label: b.rearWing },
];
---

<section class="car-state" data-block="car" aria-label={b.title}>
  {wings.map(({ place, label }) => (
    <p class:list={['car-state-ring', 'wing', place]} title={label} data-var={`--v:wings.${place}|ratio:100`}>
      <span data-text={`wings.${place}|fixed:0`} />
    </p>
  ))}
  <div class="car-state-car">
    <CarShape />
    <ul class="car-state-rings">
      {wheels.map(({ i, place }) => (
        <li
          class:list={['car-state-ring', 'wheel', place]}
          title={`${b.wheels[i]} · ${b.wear}`}
          data-var={`--v:player.damage.tyresWear.${i}|ratio:100`}
        >
          <span data-text={`player.damage.tyresWear.${i}|fixed:0`} />
        </li>
      ))}
    </ul>
  </div>
</section>
