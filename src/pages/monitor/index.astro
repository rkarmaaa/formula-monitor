---
import { href } from '@lib/paths';
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import MonitorBar from '@components/monitor/MonitorBar.astro';
import AllBlocks from '@components/monitor/AllBlocks.astro';
import Session from '@components/blocks/Session.astro';
import Timing from '@components/blocks/Timing.astro';
import Map from '@components/blocks/Map.astro';
import { t } from '@i18n/index';

const m = t.monitor;
const dots = ['.', '.', '.'];
---

<BaseLayout title={m.title} description={m.description} class="monitor-page">
  <div class="monitor" data-monitor data-view="wait">
    <main class="monitor-main" id="main" tabindex="-1">
      <h1 class="monitor-heading">{m.title}</h1>
      <section class="monitor-wait" data-wait aria-live="polite">
        <p class="monitor-wait-title">
          {m.wait.title}
          <span class="monitor-wait-dots" aria-hidden="true">
            {dots.map((dot) => (
              <span>{dot}</span>
            ))}
          </span>
        </p>
        <p class="monitor-wait-text">{m.wait.text}</p>
        <p class="monitor-wait-detail" data-wait-detail>
          {m.wait.detail.connecting}
        </p>
        <Button href={`${href('')}#tutorial`} variant="outline">
          {m.wait.tutorial}
        </Button>
      </section>
      <div class="monitor-board" data-board>
        <Session />
        <Map />
        <Timing />
      </div>
      <AllBlocks />
    </main>
    <MonitorBar />
  </div>
</BaseLayout>

<script>
  import '@scripts/monitor/index';
</script>
