---
import BaseLayout from '@layouts/BaseLayout.astro';
import UdpSettings from '@components/setup/UdpSettings.astro';
import MonitorBar from '@components/monitor/MonitorBar.astro';
import Header from '@components/blocks/Header.astro';
import PlayerCard from '@components/blocks/PlayerCard.astro';
import Timing from '@components/blocks/Timing.astro';
import Forecast from '@components/blocks/Forecast.astro';
import Engine from '@components/blocks/Engine.astro';
import Feed from '@components/blocks/Feed.astro';
import Pedals from '@components/blocks/Pedals.astro';
import Car from '@components/blocks/Car.astro';
import { t } from '@i18n/index';
import { site } from '@data/site';

const m = t.monitor;
const dots = ['.', '.', '.'];
---

<BaseLayout title={m.title} description={m.description} class="monitor-page">
  <div class="monitor" data-monitor data-view="wait">
    <main class="monitor-main" id="main" tabindex="-1">
      <h1 class="monitor-heading">{m.title}</h1>
      <section class="monitor-wait" data-wait>
        <div class="monitor-wait-intro">
          <p class="monitor-wait-eyebrow">
            {t.common.brand} · v{site.version}
          </p>
          <p class="monitor-wait-title">
            {m.wait.title}
            <span class="monitor-wait-dots" aria-hidden="true">
              {dots.map((dot) => (
                <span>{dot}</span>
              ))}
            </span>
          </p>
          <p class="monitor-wait-text">{m.wait.text}</p>
          <p class="monitor-wait-detail" data-wait-detail aria-live="polite">
            {m.wait.detail.connecting}
          </p>
          <div class="monitor-wait-url">
            <p class="monitor-wait-label">{m.wait.devices}</p>
            <p class="monitor-wait-address" data-wait-url>
              {m.wait.devicesEmpty}
            </p>
          </div>
        </div>
        <div class="monitor-wait-settings">
          <p class="monitor-wait-label">{m.wait.settings}</p>
          <p class="monitor-wait-path">{t.home.tutorial.steps[1]!.text}</p>
          <UdpSettings />
        </div>
      </section>
      <div class="monitor-board" data-board>
        <Header />
        <PlayerCard />
        <Timing />
        <Forecast />
        <Engine />
        <Feed />
        <Pedals />
        <Car />
      </div>
    </main>
    <MonitorBar />
  </div>
</BaseLayout>

<script>
  import '@scripts/monitor/index';
</script>
