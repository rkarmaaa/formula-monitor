---
import { href } from '@lib/paths';
import SiteLayout from '@layouts/SiteLayout.astro';
import Button from '@components/ui/Button.astro';
import { accent } from '@lib/text';
import { t } from '@i18n/index';

const n = t.notFound;
---

<SiteLayout title={n.title} description={n.description}>
  <section class="not-found">
    <p class="not-found-eyebrow">{n.eyebrow}</p>
    <h1 class="not-found-title" set:html={accent(n.heading)} />
    <p class="not-found-lead">{n.lead}</p>
    <Button href={href('')} variant="outline" icon="lucide:arrow-left">
      {n.home}
    </Button>
  </section>
</SiteLayout>
