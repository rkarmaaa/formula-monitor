---
import { href } from '@lib/paths';
import SiteLayout from '@layouts/SiteLayout.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import HeroCar from '@components/home/HeroCar.astro';
import UdpSettings from '@components/setup/UdpSettings.astro';
import CommandList from '@components/setup/CommandList.astro';
import { accent } from '@lib/text';
import { t } from '@i18n/index';

const h = t.home;
const tut = h.tutorial;
const [run, game, open] = tut.steps;
---

<SiteLayout title={h.title} description={h.description}>
  <section class="home-hero" aria-labelledby="home-title">
    <HeroCar />
    <div class="home-hero-content">
      <p class="home-hero-eyebrow">{h.hero.eyebrow}</p>
      <h1 class="home-hero-title" id="home-title" set:html={accent(h.hero.heading)} />
      <div class="home-hero-actions">
        <Button href={href('monitor/')} size="lg" arrow>
          {h.hero.start}
        </Button>
        <Button href="#tutorial" size="lg" variant="outline">
          {h.hero.tutorial}
        </Button>
      </div>
    </div>
    <a class="home-hero-scroll" href="#tutorial" aria-label={h.hero.scroll}>
      <Icon name="lucide:arrow-down" />
    </a>
  </section>

  <section class="home-tutorial" id="tutorial" aria-labelledby="tutorial-title">
    <header class="home-tutorial-head" data-reveal>
      <p class="home-tutorial-eyebrow">{tut.eyebrow}</p>
      <h2 class="home-tutorial-title" id="tutorial-title" set:html={accent(tut.heading)} />
      <p class="home-tutorial-lead">{tut.lead}</p>
    </header>

    <ol class="home-tutorial-steps">
      <li class="home-tutorial-step" data-reveal>
        <span class="home-tutorial-num" aria-hidden="true">
          01
        </span>
        <div class="home-tutorial-body">
          <h3 class="home-tutorial-step-title">{run!.title}</h3>
          <p class="home-tutorial-text">{run!.text}</p>
          <CommandList lines={['npm install', 'npm run build', 'npm start']} />
        </div>
      </li>
      <li class="home-tutorial-step" data-reveal>
        <span class="home-tutorial-num" aria-hidden="true">
          02
        </span>
        <div class="home-tutorial-body">
          <h3 class="home-tutorial-step-title">{game!.title}</h3>
          <p class="home-tutorial-text">{game!.text}</p>
          <UdpSettings />
        </div>
      </li>
      <li class="home-tutorial-step" data-reveal>
        <span class="home-tutorial-num" aria-hidden="true">
          03
        </span>
        <div class="home-tutorial-body">
          <h3 class="home-tutorial-step-title">{open!.title}</h3>
          <p class="home-tutorial-text">{open!.text}</p>
          <CommandList lines={[h.urlPlaceholder]} live="url" />
          <div class="home-tutorial-actions">
            <Button href={href('monitor/')} arrow>
              {h.hero.start}
            </Button>
          </div>
        </div>
      </li>
    </ol>

    <aside class="home-tutorial-trouble" data-reveal>
      <h3 class="home-tutorial-step-title">{tut.troubleTitle}</h3>
      <ul class="home-tutorial-list">
        {tut.trouble.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    </aside>
  </section>
</SiteLayout>
